{
	"compilerOptions": {
		"target": "es2023",
		"module": "es2022",
		"moduleResolution": "node",
		"skipLibCheck": true,
		"allowJs": true,
		"strict": true,
		"strictPropertyInitialization": false,
		"rootDir": "./webapp",
		"paths": {
			"UI5con2025.notheming/*": ["./webapp/*"]
		},
		"composite": true
	},
	"include": ["./webapp/**/*"]
}
